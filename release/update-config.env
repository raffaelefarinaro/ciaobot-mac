# Public update configuration for CIAOBOT_RELEASE_UPDATES=1 builds.
#
# Everything in this file is committed and public. It is read by
# scripts/build-app.sh and written into the app's Info.plist; it is never a
# secret store. The EdDSA *private* key that signs archives lives only in the
# operator's keychain and must never be added here.
#
# UPDATE_FEED_URL is the appcast this client polls. It is a GitHub release
# asset on the `updates` tag, so publishing an appcast never rewrites source.
# UPDATE_PUBLIC_ED_KEY is the Sparkle EdDSA public key. Sparkle refuses an
# update that is not signed with the matching private key.
# UPDATE_MIN_SYSTEM_VERSION must match LSMinimumSystemVersion in
# scripts/build-app.sh; the build fails if the two disagree.
UPDATE_FEED_URL=https://github.com/raffaelefarinaro/ciaobot-mac/releases/download/updates/appcast.xml
UPDATE_PUBLIC_ED_KEY=uLLvdsFBrO33Zb9zLZ+m/ZUun3D9vUf+9t1ufoa2guM=
UPDATE_MIN_SYSTEM_VERSION=13.0
